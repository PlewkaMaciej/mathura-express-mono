datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  clerkId   String    @unique
  email     String?   @unique
  firstName String?
  lastName  String?
  createdAt DateTime  @default(now())
}
